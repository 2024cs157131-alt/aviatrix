# Process configuration only. Put real values in your host's secret store, never in the repo.
# Provider keys (M-Pesa, Cashia) are NOT configured here — the admin enters them in /admin,
# and they are stored AES-256-GCM encrypted in the database.

# Pooled URL (PgBouncer / Neon pooler / Supabase Supavisor in transaction mode is fine)
DATABASE_URL=
# Direct (non-pooled) URL: used for LISTEN/NOTIFY, the round engine's leader lock and migrations.
# Leave empty if DATABASE_URL is already a direct connection.
DATABASE_DIRECT_URL=
# Connections per process (Aiven free plan caps at 20 total: use ~6)
PG_POOL_MAX=20
# DATABASE_SSL=true

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored provider credentials and phone numbers unreadable. Back it up in your secret store.
SETTINGS_ENCRYPTION_KEY=

# Public HTTPS origin players use, e.g. https://play.example.co.ke
PUBLIC_ORIGIN=

# Split deploy only (site on Vercel, API elsewhere): the backend's WebSocket URL, e.g. wss://api.example.co.ke/ws
PUBLIC_WS_URL=

NODE_ENV=production
PORT=3000
# Number of reverse-proxy hops in front of the app (for correct client IPs / HTTPS detection)
TRUST_PROXY=1   # use 2 behind Vercel's /api proxy + your host's load balancer
